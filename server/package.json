    "clsx": "^2.0.0",
    "happy-dom": "^20.11.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}

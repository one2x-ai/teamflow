#!/usr/bin/env bash
set -euo pipefail

TEAMFLOW_HOME="${TEAMFLOW_HOME:-${WORKFLOW_HOME:-$HOME/.teamflow}}"
MEMORY_ROOT="${TEAMFLOW_MEMORY_HOME:-${WORKFLOW_MEMORY_HOME:-${OPENCODE_WORKFLOW_MEMORY_HOME:-$TEAMFLOW_HOME/memory}}}"
export BASIC_MEMORY_AUTO_UPDATE=false
export BASIC_MEMORY_CONFIG_DIR="$MEMORY_ROOT/state"
export BASIC_MEMORY_HOME="$MEMORY_ROOT/knowledge"
export BASIC_MEMORY_SEMANTIC_SEARCH_ENABLED=false

usage() {
  cat <<'EOF'
Usage:
  teamflow memory recall <query>
    Defaults to this repository's namespace (projects/<slug>/*) plus global/*
    filtered locally from paged unscoped search, preserving upstream ranking
    with permalink dedupe. Set TEAMFLOW_MEMORY_RECALL_SCOPE=all to opt into
    a single unscoped all-memory search.
  teamflow memory remember <verified project finding>
  teamflow memory remember-global <verified reusable finding>
  teamflow memory read <memory-url-or-permalink>
  teamflow memory context <memory-url-or-permalink>
  teamflow memory list
  teamflow memory status
EOF
}

if ! command -v basic-memory >/dev/null 2>&1; then
  echo '{"status":"error","error":"basic-memory is not installed; run the teamflow bootstrap"}' >&2
  exit 1
fi

PROJECT_NAME="${TEAMFLOW_MEMORY_PROJECT:-${WORKFLOW_MEMORY_PROJECT:-${BASIC_MEMORY_PROJECT:-teamflow}}}"
ACTION="${1:-}"
if [[ -z "$ACTION" ]]; then
  usage >&2
  exit 1
fi
shift

WORKING_DIRECTORY="$(pwd -P)"
REPOSITORY="$(git -C "$WORKING_DIRECTORY" config --get remote.origin.url 2>/dev/null || printf '%s' "$WORKING_DIRECTORY")"
REPOSITORY_NAME="${REPOSITORY##*/}"
REPOSITORY_NAME="${REPOSITORY_NAME%.git}"
REPOSITORY_SLUG="$(printf '%s' "$REPOSITORY_NAME" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]._-' '-')"
REPOSITORY_SLUG="${REPOSITORY_SLUG%-}"

require_text() {
  if (( $# == 0 )); then
    echo "error: $ACTION requires text" >&2
    exit 1
  fi
}

write_finding() {
  local scope="$1"
  local folder="$2"
  shift 2
  local finding="$*"
  local recorded_at hash title content
  recorded_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  hash="$(printf '%s\0%s\0%s' "$scope" "$REPOSITORY" "$finding" | shasum -a 256 | cut -c1-12)"
  title="Verified finding $hash"
  content="$(printf '# Verified finding\n\n%s\n\n## Observations\n\n- [fact] %s\n- [scope] %s\n- [source] Repository: %s\n- [evidence] Recorded by teamflow only after required verification reported PASS.\n- [recorded] %s\n' \
    "$finding" "$finding" "$scope" "$REPOSITORY" "$recorded_at")"

  basic-memory tool write-note \
    --title "$title" \
    --folder "$folder" \
    --content "$content" \
    --tags "coding,teamflow,verified" \
    --type "teamflow-finding" \
    --project "$PROJECT_NAME" \
    --overwrite \
    --local
}

case "$ACTION" in
  recall)
    require_text "$@"
    if [[ "${TEAMFLOW_MEMORY_RECALL_SCOPE:-repository}" == "all" ]]; then
      basic-memory tool search-notes "$*" \
        --page-size 8 --project "$PROJECT_NAME" --local
    else
      # Default scope: paginate unscoped text search (never --permalink, which
      # is a boolean flag in real basic-memory), then filter + dedupe locally.
      pages_dir="$(mktemp -d "${TMPDIR:-/tmp}/teamflow-recall.XXXXXX")"
      trap 'rm -rf "$pages_dir"' EXIT
      page=1
      max_pages=1000
      while (( page <= max_pages )); do
        out="$(basic-memory tool search-notes "$*" \
          --page "$page" --page-size 8 --project "$PROJECT_NAME" --local)" || out=""
        printf '%s' "$out" > "${pages_dir}/${page}.json"
        advance="$(RECALL_PAGE_FILE="${pages_dir}/${page}.json" python3 - <<'PY' || printf 'no'
import json
import os

try:
    with open(os.environ["RECALL_PAGE_FILE"], encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, ValueError):
    data = {}
if not isinstance(data, dict):
    data = {}
results = data.get("results")
has_more = data.get("has_more")
# Stop on missing/non-true has_more, or on an empty page (defensive).
print("yes" if has_more is True and isinstance(results, list) and results else "no")
PY
)"
        [[ "$advance" == "yes" ]] || break
        page=$((page + 1))
      done
      RECALL_PAGES_DIR="$pages_dir" \
      RECALL_REPO_PREFIX="${PROJECT_NAME}/projects/${REPOSITORY_SLUG}/" \
      RECALL_GLOBAL_PREFIX="${PROJECT_NAME}/global/" \
      python3 - <<'PY'
import json
import os

pages_dir = os.environ["RECALL_PAGES_DIR"]
repo_prefix = os.environ["RECALL_REPO_PREFIX"]
global_prefix = os.environ["RECALL_GLOBAL_PREFIX"]

seen = set()
final = []
page = 1
while True:
    path = os.path.join(pages_dir, "%d.json" % page)
    if not os.path.exists(path):
        break
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        data = {}
    results = data.get("results") if isinstance(data, dict) else None
    if isinstance(results, list):
        for item in results:
            if not isinstance(item, dict):
                continue
            permalink = item.get("permalink")
            if permalink is None:
                continue
            if not (permalink.startswith(repo_prefix) or permalink.startswith(global_prefix)):
                continue
            if permalink in seen:
                continue
            seen.add(permalink)
            final.append(item)
    page += 1

print(json.dumps({"results": final, "total": len(final)}))
PY
    fi
    ;;
  remember)
    require_text "$@"
    write_finding "repository-specific" "projects/$REPOSITORY_SLUG" "$@"
    ;;
  remember-global)
    require_text "$@"
    write_finding "cross-project" "global" "$@"
    ;;
  read)
    require_text "$@"
    basic-memory tool read-note "$1" \
      --include-frontmatter --project "$PROJECT_NAME" --local
    ;;
  context)
    require_text "$@"
    basic-memory tool build-context "$1" \
      --depth 2 --timeframe 30d --page-size 20 \
      --project "$PROJECT_NAME" --local
    ;;
  list)
    basic-memory tool recent-activity \
      --timeframe 365d --page-size 50 --project "$PROJECT_NAME" --local
    ;;
  status)
    basic-memory project info "$PROJECT_NAME" --local --json
    basic-memory status --project "$PROJECT_NAME" --local
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "error: unknown memory action: $ACTION" >&2
    usage >&2
    exit 1
    ;;
esac
